{
  "name": "codex-usage-desktop",
  "version": "6.2.0",
  "private": true,
  "type": "module",
  "description": "Local-first desktop dashboard for Codex CLI token usage and cost estimates.",
  "homepage": "https://github.com/itvincent-git/codex-usage-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itvincent-git/codex-usage-desktop.git"
  },
  "license": "MIT",
  "keywords": [
    "codex-cli",
    "openai-codex",
    "token-usage",
    "cost-tracking",
    "tauri"
  ],
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:app": "pnpm tauri dev",
    "build:web": "vite build",
    "build": "pnpm build:web",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "node --test scripts/release-tests.cjs scripts/homebrew-tests.cjs && vitest run",
    "test:e2e:build": "tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "test:e2e": "wdio run ./wdio.conf.ts",
    "test:e2e:restart": "wdio run ./wdio.restart.conf.ts",
    "test:e2e:child-reaping": "node scripts/test-child-reaping.cjs",
    "bump": "node scripts/bump-version.cjs",
    "release": "node scripts/release.cjs",
    "downloads:trend": "node scripts/release-download-trend.cjs",
    "preversion": "node scripts/preversion.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-log": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "highlight.js": "^11.12.0",
    "i18next": "^26.7.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "@wdio/types": "^9.32.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
