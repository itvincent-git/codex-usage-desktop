{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Usage Desktop",
  "version": "0.1.0",
  "identifier": "com.ccusage.codex.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:tauri",
    "beforeBuildCommand": "pnpm build:web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Usage Desktop",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:43110 http://localhost:43110 ws://localhost:5173 http://localhost:5173;"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
