{
  "build": {
    "beforeBuildCommand": "pnpm build --mode e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        "quota",
        {
          "identifier": "e2e",
          "windows": ["main", "quota"],
          "permissions": ["wdio:default", "wdio-webdriver:default", "core:window:allow-set-focus", "core:window:allow-set-position", "core:window:allow-show", "core:window:allow-hide", "core:window:allow-set-fullscreen"]
        }
      ]
    }
  }
}
