{
  "build": {
    "beforeBuildCommand": "pnpm build --mode e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        "tray",
        {
          "identifier": "e2e",
          "windows": ["main", "tray"],
          "permissions": ["wdio:default", "wdio-webdriver:default", "core:window:allow-set-focus"]
        }
      ]
    }
  }
}
